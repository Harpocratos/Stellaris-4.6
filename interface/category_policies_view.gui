@dynamic_extra = 0.8

guiTypes = {
	containerWindowType = {
		name = "category_policies_view"
		size = { width = 610 height = 642 }
		dynamic_extra_height = @dynamic_extra
		clipping = no

		containerWindowType = {
			name = "background_box"
			size = { width = 645 height = 623 }
			dynamic_extra_height = @dynamic_extra
			position = { x = 0 y = 0 }

			background = {
				name = "background"
				spriteType = "GFX_tile_outliner_bg"
			}
		}

		buttonType = {
			name = "close_button"
			quadTextureSprite = "GFX_close"
			position = { x = -12 y = 16 }
			orientation = upper_right
			shortcut = "ESCAPE"
			pdx_tooltip = "CLOSE_TITLE"
			clicksound = "back_click"
		}

		iconType = {
			name = "hex_bg"
			spriteType = "GFX_hex_bg"
			position = { x = -10 y = -12 }
			alwaysTransparent = yes
		}

		containerWindowType = {
			name = "header_line_box"
			size = { width = 475 height = 90 }
			position = { x = 0 y = 0 }
			clipping = yes

			iconType = {
				name = "header_line"
				spriteType = "GFX_line_long"
				position = { x = 6 y = 21 }
			}
		}

		instantTextBoxType = {
			name = "header"
			font = "malgun_goth_24"
			position = { x = 20 y = 6 }
			maxWidth = 400
			maxHeight = 20
			fixedSize = yes
			orientation = "UPPER_LEFT"
			format = LEFT
		}

		smoothListboxType = {
			name = "policy_list"
			position = { x = 10 y = 60 }
			size = { x = 580 y = 562 }
			dynamic_extra_height = @dynamic_extra
			backGround = ""
			spacing = 1
			scrollbartype = "standardlistbox_slider"
			borderSize = { x = 0 y = 0 }
			orientation = "UPPER_LEFT"
		}
	}

	containerWindowType = {
		name = "category_policy_entry"
		size = { width = 580 height = 30 }
		position = { x = 10 y = 10 }
		moveable = no

		buttonType = {
			name = "background"
			quadTextureSprite = "GFX_tiles_dark_area_cut_8_hover"
			size = { x = 580 y = 27 }
			clicksound = "outliner_click_tab"
			oversound = no_sound
		}

		iconType = {
			name = "can_change"
			alwaysTransparent = yes
			position = { x = 26 y = 6 }
			quadTextureSprite = "GFX_on_off_indicator"
			frame = 1
		}

		instantTextBoxType = {
			name = "policy_name"
			font = "cg_16b"
			position = { x = 46 y = 5 }
			fixedSize = yes
			format = left
			maxWidth = 300
			alwaysTransparent = yes
		}

		instantTextBoxType = {
			name = "selected_option_name"
			font = "cg_16b"
			position = { x = 270 y = 5 }
			fixedSize = yes
			maxWidth = 260
			format = right
			alwaysTransparent = yes
			text_color_code = "H"
		}

		iconType = {
			name = "expand_icon"
			quadTextureSprite = "GFX_entry_expand"
			position = { x = 540 y = 3 }
			alwaysTransparent = yes
		}

		smoothListboxType = {
			name = "options"
			position = { x = 15 y = 30 }
			size = { x = 553 y = 50 }
			alwaysTransparent = yes
		}
	}

	containerWindowType = {
		name = "category_policy_option_entry"
		size = { width = 80 height = 30 }
		position = { x = 0 y = 0 }
		moveable = no

		buttonType = {
			name = "option_button"
			position = { x = 10 y = 0 }
			size = { x = 553 y = 27 }
			quadTextureSprite = "GFX_tiles_dark_area_cut_8_hover"
			oversound = no_sound
		}

		instantTextBoxType = {
			name = "name"
			font = "cg_16b"
			position = { x = 42 y = 6 }
			fixedSize = yes
			format = left
			alwaysTransparent = yes
			text = "policyname"
			text_color_code = "E"
		}

		iconType = {
			name = "is_selected"
			alwaysTransparent = yes
			position = { x = 14 y = 2 }
			quadTextureSprite = "GFX_radio_button"
			frame = 1
			scale = 0.8
		}
	}
}
